// Provides the `Hash` trait and related traits, and basic hashing functions.
//
// To hash a type of your own, implement `Hash` for it and combine the hashes of its fields by
// `combine_hash`.
//
// ```fix
// # module DocTest;
// # import Hash;
// type Point = struct { x : I64, y : I64 };
//
// impl Point : Hash {
//     hash = |p| combine_hash(p.@x.hash, p.@y.hash);
// }
//
// # main : IO ();
// # main = (
// assert_eq(|_|"", Point { x : 1, y : 2 }.hash, Point { x : 1, y : 2 }.hash)
// # );
// ```
module Hash;

import Std::{
    loop, Array, Eq, I16, I32, I64, I8, String, U16, U32, U64, U8, Array::{@size, @},
    LoopState::{break, continue}, String::@_data, ToU64::u64,
    U64::{bit_xor, shift_left, shift_right}
};

// Hashable types.
trait a : Hash {
    hash : a -> U64;
}

// Hashable and comparable types.
// 
// Type implementing `HashKey` can be keys in a hash table.
trait HashKey = Hash + Eq;

// Combines two hashes.
// 
// Using method described in https://stackoverflow.com/questions/5889238/why-is-xor-the-default-way-to-combine-hashes.
combine_hash : U64 -> U64 -> U64;
combine_hash = |a, b| (
    a.bit_xor(b + 0x517cc1b727220a95_U64 + (a.shift_left(6_U64)) + (a.shift_right(2_U64)))
);

impl [a : Hash] Array a : Hash {
    // The accumulator is multiplied by an odd constant before each element is exclusive-ored into
    // it: the multiplication carries every bit the accumulator holds up into the bits above it, and
    // the exclusive or lays the element's hash over all 64 bits at once, so the low bits a hash
    // table indexes by depend on every element.
    //
    // Those low bits come from the low bits of the element hashes, so an instance of `Hash` is
    // expected to spread its value over all 64 bits.
    hash = |arr| (
        let len = arr.@size;
        loop((0, 5381_U64), |(i, h)| (
            if i == len { break $ h };
            continue $ (i+1, (h * 0x9e3779b97f4a7c15_U64).bit_xor(arr.@(i).hash))
        ))
    );
}

impl String : Hash {
    hash = |s| s.@_data.hash;
}

impl U8 : Hash {
    hash = |x| x.u64.hash;
}

impl I8 : Hash {
    hash = |x| x.u64.hash;
}

impl U16 : Hash {
    hash = |x| x.u64.hash;
}

impl I16 : Hash {
    hash = |x| x.u64.hash;
}

impl U32 : Hash {
    hash = |x| x.u64.hash;
}

impl I32 : Hash {
    hash = |x| x.u64.hash;
}

impl U64 : Hash {
    hash = |x| (
        // https://stackoverflow.com/questions/664014/what-integer-hash-function-are-good-that-accepts-an-integer-hash-key
        let x = x.bit_xor(x.shift_right(30_U64)) * 13787848793156543929_U64;
        let x = x.bit_xor(x.shift_right(27_U64)) * 10723151780598845931_U64;
        x.bit_xor(x.shift_right(31_U64))
    );
}

impl I64 : Hash {
    hash = |x| x.u64.hash;
}

impl [a : Hash, b : Hash] (a, b) : Hash {
    hash = |(a, b)| combine_hash(a.hash, b.hash);
}